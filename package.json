{
  "name": "agent-feedbacker",
  "version": "0.1.0",
  "description": "A local merge-request-style review page that coding agents open to collect your line comments and answers, across several git repos.",
  "type": "module",
  "bin": {
    "feedbacker": "bin/feedbacker.mjs"
  },
  "files": [
    "bin",
    "src/*.mjs",
    "src/page.html",
    "src/dist",
    "skills",
    ".claude-plugin",
    ".mcp.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PavlikPolivka/feedbacker.git"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "code-review",
    "diff",
    "agent"
  ],
  "author": "Pavel Polivka",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "homepage": "https://github.com/PavlikPolivka/feedbacker#readme",
  "bugs": {
    "url": "https://github.com/PavlikPolivka/feedbacker/issues"
  }
}
